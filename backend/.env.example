APP_NAME="Digital Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Use mysql for production; sqlite works locally without Docker
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcast: use REVERB for production, log for local dev
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=redis

# Redis (local ServBay or Docker)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Reverb (WebSockets) — run: php artisan reverb:start
REVERB_APP_ID=marketplace
REVERB_APP_KEY=marketplace-key
REVERB_APP_SECRET=marketplace-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Payment gateways (mock values — replace with real keys for production)
BINANCE_PAY_KEY=MOCK_BINANCE_KEY
BINANCE_PAY_SECRET=MOCK_BINANCE_SECRET
USDT_WALLET_ADDRESS=0xMOCKUSDTWALLETADDRESS
USDT_WEBHOOK_SECRET=MOCK_USDT_SECRET

# Mail (log for local dev)
MAIL_MAILER=log

VITE_APP_NAME="Digital Marketplace"
VITE_API_URL=http://localhost:8000/api
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_APP_KEY=marketplace-key
